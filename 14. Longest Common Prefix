class Solution {
public:
    string longestCommonPrefix(vector<string>& strs) {
      if(strs.size() == 0)return "";
      string first = strs[0];
      string ans = "";

      for(int i=0; i<first.size(); i++){
            char ch = first[i];

            for(int j = 1; j<strs.size(); j++){
                if(i >= strs[j].size() || strs[j][i] != ch){
                    return ans;
                }
            }
            ans = ans + ch;
        }  
        return ans;
    }
};
