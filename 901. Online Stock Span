class StockSpanner {
public:
    stack<pair<int,int>> st; // {price, day}
    int day;
    StockSpanner() {
        day = -1;
    }
    
    int next(int price) {
        day++;
        while(!st.empty() && st.top().first <= price) {
            st.pop();
        }
        if(st.empty()) {
            st.push({price, day});
            return day + 1;
        }
        int span = day - st.top().second;
        st.push({price, day});
        return span;
    }
};

